<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\oo2core.dll" Link="oo2core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- XamlLoadTests 要真正 new 出来 MainWindow，必须引用 App 与 Ui。
         App 是 WinExe，测试工程引用它没问题：入口点不参与，只当类库用。 -->
    <ProjectReference Include="../../src/PoEToolbox.Ui/PoEToolbox.Ui.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.App/PoEToolbox.App.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Core/PoEToolbox.Core.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Plugins.DataBrowser/PoEToolbox.Plugins.DataBrowser.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Plugins.BagCleaner/PoEToolbox.Plugins.BagCleaner.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Plugins.PoeCnPatch/PoEToolbox.Plugins.PoeCnPatch.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Plugins.Poe2Font/PoEToolbox.Plugins.Poe2Font.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Plugins.AffixWorkbench/PoEToolbox.Plugins.AffixWorkbench.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Plugins.MapWorkbench/PoEToolbox.Plugins.MapWorkbench.csproj" />
    <ProjectReference Include="../../src/PoEToolbox.Shared/PoEToolbox.Shared.csproj" />
  </ItemGroup>
</Project>
