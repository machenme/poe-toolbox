<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LibBundledGGPK3\LibBundledGGPK3.csproj" />
    <ProjectReference Include="..\PoEToolbox.Shared\PoEToolbox.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\NameDictionaries\*.json" />
    <EmbeddedResource Include="Assets\Translation\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    DDS 贴图渲染用 GDI+（System.Drawing.Bitmap）。System.Drawing.Common 属于桌面框架包的
    WindowsForms 分组，必须在这里显式声明：原先写的 UseSystemDrawing 在 .NET 10 SDK 上是空转属性，
    之所以能编译，是靠 Shared 的 UseWPF 把框架引用传递过来——Shared 去掉 WPF 后就断了。
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
