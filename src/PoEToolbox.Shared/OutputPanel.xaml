<UserControl x:Class="PoEToolbox.Shared.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 统一输出面板：日志区 + 语义化状态栏。所有插件复用同一实现，保证成功/失败反馈一致。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="" Style="{DynamicResource SectionText}" Margin="0,0,0,8"/>

        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 Background="{DynamicResource SurfaceBrush}"/>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,5"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <TextBlock x:Name="StatusText" Text="就绪" Style="{DynamicResource SmallText}"/>
        </Border>
    </Grid>
</UserControl>
