<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PoEToolbox.Shared</RootNamespace>
    <!-- Native AOT 目标：普通 build 就要暴露 trim/AOT 不兼容，不等 publish。
         警告清零前这条链不算 AOT 就绪。 -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoEToolbox.Abstractions\PoEToolbox.Abstractions.csproj" />
    <ProjectReference Include="..\LibBundledGGPK3\LibBundledGGPK3.csproj" />
    <ProjectReference Include="..\LibDat2\LibDat2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PoEToolbox.Tests" />
    <InternalsVisibleTo Include="PoEToolbox.Plugins.FxPatch" />
    <InternalsVisibleTo Include="PoEToolbox.Plugins.AffixWorkbench" />
    <InternalsVisibleTo Include="PoEToolbox.App" />
    <InternalsVisibleTo Include="PoEToolbox" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置补丁源文件只有这一处：编译进 exe，运行时释放到工具箱数据目录（AppData）读取。
         不再往输出目录复制，避免「exe 旁副本 / 数据目录副本」两个来源不一致。 -->
    <EmbeddedResource Include="Patches\**\*.patch.json" LogicalName="Patches.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
