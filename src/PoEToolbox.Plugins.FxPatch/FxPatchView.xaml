<UserControl x:Class="PoEToolbox.Plugins.FxPatch.FxPatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:PoEToolbox.Shared;assembly=PoEToolbox.Shared"
             Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 左列：补丁来源（整列：内置列表 + 第三方补丁列表 + 自定义入口） ── -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
            <DockPanel>
                <!-- 底部：自定义补丁入口 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Separator Margin="0,0,0,8" Background="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="安装新的第三方补丁（.patch.json / .zip）" Style="{StaticResource SmallText}"
                               ToolTip="fx-patch diff 生成的 .patch.json，或打包成 zip 的补丁包（patch.json + assets/）；也支持作者直接打包的整包替换补丁（含 _.index.bin 与 bundle 文件）——应用时会先把同名原文件备份到 backup\补丁名\ 再覆盖。一次选择并应用一个。"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PatchJsonBox" Height="32" IsReadOnly="True"
                                 ToolTip="fx-patch diff 生成的 .patch.json，或打包成 zip 的补丁包（patch.json + assets/）；也支持作者直接打包的整包替换补丁（含 _.index.bin 与 bundle 文件）——应用时会先把同名原文件备份到 backup\补丁名\ 再覆盖。选择后会出现在上方第三方补丁列表里，默认勾选；这里只显示名字，完整路径在悬停提示里。"/>
                        <Button x:Name="BrowsePatchButton" Grid.Column="2" Content="选择文件"
                                ToolTip="选择自定义补丁文件（.patch.json 或 .zip 补丁包），选完会加入上方第三方补丁列表并默认勾选。"
                                Style="{StaticResource SecondaryButton}" Width="104"
                                Click="BrowsePatch_Click"/>
                    </Grid>
                </StackPanel>

                <!-- 上部：列表 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="补丁来源" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                        <TextBlock Text="内置补丁（可勾选多个一起执行）" Style="{StaticResource SmallText}"
                                   ToolTip="已经启用过的补丁会自动显示状态并勾选，可直接还原；取消勾选不会改动游戏，只是不参与本次操作。"/>
                        <StackPanel x:Name="BuiltInChecksPanel" Margin="0,4,0,0"/>
                        <TextBlock x:Name="BuiltInStateHint" Text="尚未读取补丁状态。"
                                   Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <Separator Margin="0,12,0,8" Background="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="第三方补丁" Style="{StaticResource SmallText}"
                                   ToolTip="上面的待应用条目来自底部选择的补丁文件；下面的来自补丁记录（已应用）。勾选后可用「启用 / 恢复 / 卸载」批量处理。"/>
                        <TextBlock x:Name="ThirdPartyEmpty" Text="没有读取到已安装的第三方补丁。"
                                   Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                        <StackPanel x:Name="ThirdPartyPanel" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── 右列：上=操作（2×2），下=引擎输出 ── -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <Button x:Name="ApplyButton" Content="启用特效补丁"
                            ToolTip="写入前自动备份原版索引；已经启用会自动跳过，重复执行不会出错。对勾选的所有内置补丁（或所选自定义补丁）执行。"
                            Style="{StaticResource PrimaryButton}" Height="42" Click="Apply_Click"/>
                    <TextBlock Text="把勾选的补丁装进游戏，随时可以再改回来。"
                               Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Button x:Name="RevertButton" Content="恢复游戏原版"
                            ToolTip="用备份的原版索引整体替换当前索引，并删除所有补丁新增的文件——包括第三方补丁，全部补丁记录一并清空。整包替换型补丁覆盖的原生文件除外（需用对应补丁的还原功能）。"
                            Style="{StaticResource SecondaryButton}" Height="42"
                            Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}" Click="Revert_Click"/>
                    <TextBlock Text="整体恢复原版：全部补丁（含第三方）都会被移除，之后想再用需重新启用。"
                               Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <Button x:Name="StatusButton" Content="刷新补丁状态"
                            ToolTip="重新读取游戏数据，更新每个补丁的启用状态并同步勾选。只读检查，不改动任何东西。"
                            Style="{StaticResource SecondaryButton}" Height="42" Click="Status_Click"/>
                    <TextBlock Text="手动重查一遍装没装（换过游戏目录时用）。"
                               Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <Button x:Name="PurgeButton" Content="卸载已勾选补丁"
                            ToolTip="完整卸载勾选的补丁：撤销修改并删除新增文件；其他未勾选的补丁不受影响。卸载后要重新应用补丁才能再用。想整体恢复原版用「恢复游戏原版」。"
                            Style="{StaticResource SecondaryButton}" Height="42" Click="Purge_Click"/>
                    <TextBlock Text="撤销修改并删除勾选补丁的文件，其他补丁不受影响；整体恢复请用「恢复游戏原版」。"
                               Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

            <!-- 引擎输出 -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                <shared:OutputPanel x:Name="Output" Title="引擎输出"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                Padding="8,5" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <TextBlock x:Name="FooterText" Text="提示：应用前关闭游戏。" Style="{StaticResource SmallText}"/>
        </Border>
    </Grid>
</UserControl>
