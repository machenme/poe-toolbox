<UserControl x:Class="PoEToolbox.Plugins.FxPatch.FxPatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:PoEToolbox.Shared;assembly=PoEToolbox.Shared"
             Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 左列：输入与操作 ── -->
        <StackPanel Grid.Row="0" Grid.Column="0">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="游戏数据" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GameDataPathBox" Height="32"
                                 ToolTip="选择 Content.ggpk、_.index.bin 或包含它们的游戏目录"/>
                        <Button Grid.Column="2" Content="选择..." Style="{StaticResource SecondaryButton}"
                                Width="88" Click="BrowseGame_Click"/>
                    </Grid>
                    <TextBlock Text="修改前请关闭游戏。索引修改会自动备份（baseline + journal）。"
                               Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="补丁来源" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="PatchSourceBox" Height="32" SelectionChanged="PatchSource_SelectionChanged">
                        <ComboBoxItem Content="内置：黏油榴弹特效+地面燃烧特效（oil-grenade-fx-lite）" IsSelected="True"/>
                        <ComboBoxItem Content="自定义补丁描述文件（patch.json / .zip 补丁包）"/>
                    </ComboBox>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PatchJsonBox" Height="32" IsEnabled="False"
                                 ToolTip="fx-patch diff 生成的 .patch.json，或打包成 zip 的补丁包（含 patch.json + assets/）"/>
                        <Button x:Name="BrowsePatchButton" Grid.Column="2" Content="选择..."
                                Style="{StaticResource SecondaryButton}" Width="88"
                                IsEnabled="False" Click="BrowsePatch_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="操作" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <Button x:Name="StatusButton" Content="查看补丁状态"
                            Style="{StaticResource SecondaryButton}" Height="38" Click="Status_Click"/>
                    <Button x:Name="ApplyButton" Content="应用补丁（幂等，自动备份）"
                            Style="{StaticResource PrimaryButton}" Height="44" Margin="0,8,0,0" Click="Apply_Click"/>
                    <Button x:Name="RevertButton" Content="还原补丁"
                            Style="{StaticResource SecondaryButton}" Height="38" Margin="0,8,0,0" Click="Revert_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── 右列：说明 / 补丁生成器 / 输出面板 ── -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="特效补丁管理" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="指令式补丁引擎：补丁 = 一份描述文件（几 KB），引擎就地修改索引，幂等可还原、与官方更新及其他补丁叠加共存。写入统一落在游戏索引同目录 PATCHED\ 的独立 bundle 中。"
                               Style="{StaticResource NormalText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="补丁生成器（diff 两份索引自动生成补丁）" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="原版索引" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                        <TextBox x:Name="DiffVanillaBox" Grid.Column="1" Height="30"
                                 ToolTip="游戏原版 _.index.bin（或备份快照）"/>
                        <Button Grid.Column="3" Content="选择..." Style="{StaticResource SecondaryButton}"
                                Click="BrowseVanilla_Click"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="修改后索引" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                        <TextBox x:Name="DiffModifiedBox" Grid.Column="1" Height="30"
                                 ToolTip="作者修改后的 _.index.bin（其 bundle 需在同目录可用）"/>
                        <Button Grid.Column="3" Content="选择..." Style="{StaticResource SecondaryButton}"
                                Click="BrowseModified_Click"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="生成物默认输出到 %LOCALAPPDATA%\PoEToolbox\patches\&lt;补丁ID&gt;\。dat 表默认整表 asset，--dat-ptr 可启用逐行指针模式。"
                                   Style="{StaticResource SmallText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="DiffButton" Grid.Column="3" Content="生成补丁"
                                Style="{StaticResource PrimaryButton}" Click="Diff_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,0">
                <shared:OutputPanel x:Name="Output" Title="引擎输出"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                Padding="8,5" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <TextBlock x:Name="FooterText" Text="提示：应用前关闭游戏。" Style="{StaticResource SmallText}"/>
        </Border>
    </Grid>
</UserControl>
