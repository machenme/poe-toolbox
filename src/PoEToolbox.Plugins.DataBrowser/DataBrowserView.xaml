<UserControl x:Class="PoEToolbox.Plugins.DataBrowser.DataBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
                <Button x:Name="OpenFileButton" Content="打开..." Style="{StaticResource PrimaryButton}" Padding="16,6"
                        Click="Open_Click"/>
                <TextBlock x:Name="PathLabel" Grid.Column="1" VerticalAlignment="Center"
                           Style="{StaticResource SmallText}" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button x:Name="FileLockButton" Grid.Column="2" Content="释放文件占用"
                        Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                        IsEnabled="False" Click="FileLockButton_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="FileCountLabel" Grid.Column="3" VerticalAlignment="Center"
                           Style="{StaticResource SmallText}" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="PendingChangesButton" Content="保存全部修改" Style="{StaticResource PrimaryButton}"
                            Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" Click="SaveAllChanges_Click"/>
                    <Button x:Name="ViewChangesButton" Content="查看改动" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" Visibility="Collapsed" Click="ViewChanges_Click"/>
                    <Button x:Name="DiscardChangesButton" Content="撤销全部" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed" Click="DiscardChanges_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <TreeView x:Name="DirTree" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding}"
                          TreeViewItem.Expanded="DirTree_Expanded"
                          SelectedItemChanged="DirTree_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="提取文件" Click="TreeExtractFile_Click"/>
                            <MenuItem Header="替换文件" Click="TreeReplaceFile_Click"/>
                            <MenuItem Header="提取为 JSON" Click="TreeExtractJson_Click"/>
                            <MenuItem Header="复制文件路径" Click="TreeCopyFilePath_Click"/>
                            <MenuItem Header="提取文件夹" Click="TreeExtractDir_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="2,1"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="160"/>
                    <RowDefinition Height="3*" MinHeight="220"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" ToolTip="按文件名或完整路径搜索"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"/>
                        <ComboBox x:Name="ExtensionFilter" Grid.Column="1"
                                  SelectionChanged="ExtensionFilter_SelectionChanged"
                                  Width="110" Margin="8,0,0,0">
                            <ComboBoxItem Content="全部"/>
                            <ComboBoxItem Content=".dat"/>
                            <ComboBoxItem Content=".dat64"/>
                            <ComboBoxItem Content=".datc64"/>
                            <ComboBoxItem Content=".datcl64"/>
                            <ComboBoxItem Content=".json"/>
                            <ComboBoxItem Content=".txt"/>
                        </ComboBox>
                        <TextBlock x:Name="SearchStatusText" Grid.Column="2"
                                   Style="{StaticResource SmallText}" Margin="12,0,4,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="FileListPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <ListView x:Name="FileList" Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                  SelectionChanged="FileList_SelectionChanged"
                                  MouseDoubleClick="FileList_MouseDoubleClick"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="预览文件" Click="PreviewFile_Click"/>
                                    <MenuItem Header="提取文件" Click="ExtractFile_Click"/>
                                    <MenuItem Header="替换文件" Click="ReplaceFile_Click"/>
                                    <MenuItem Header="提取为 JSON" Click="ExtractJson_Click"/>
                                    <MenuItem Header="复制文件路径" Click="CopyFilePath_Click"/>
                                    <MenuItem Header="提取文件夹" Click="ExtractDir_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="220"
                                                    DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="路径" Width="360"
                                                    DisplayMemberBinding="{Binding FullPath}"/>
                                    <GridViewColumn Header="大小" Width="100"
                                                    DisplayMemberBinding="{Binding SizeDisplay}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock x:Name="FileListPlaceholder" Text="打开游戏数据文件开始浏览"
                                   Style="{StaticResource NormalText}"
                                   Foreground="{DynamicResource PlaceholderBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border x:Name="PreviewPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PreviewTitle" Style="{StaticResource SectionText}"/>
                                <TextBlock x:Name="PreviewSummary" Style="{StaticResource SmallText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="EditFileButton" Content="编辑" Style="{StaticResource SecondaryButton}"
                                        Click="EditFile_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                                <Button x:Name="SaveFileButton" Content="暂存修改" Style="{StaticResource PrimaryButton}"
                                        Click="SaveFile_Click" Visibility="Collapsed" IsEnabled="False" Margin="0,0,8,0"/>
                                <Button x:Name="CancelEditButton" Content="取消编辑" Style="{StaticResource SecondaryButton}"
                                        Click="CancelEdit_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                                <Button Content="重新加载" Style="{StaticResource SecondaryButton}"
                                        Click="ReloadPreview_Click" Visibility="Collapsed" x:Name="ReloadPreviewButton"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="EditorToolbar" Grid.Row="1" Visibility="Collapsed" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FindTextBox" ToolTip="查找文本" Margin="0,0,8,0"
                                     KeyDown="EditorSearch_KeyDown"/>
                            <TextBox x:Name="ReplaceTextBox" Grid.Column="1" ToolTip="替换为" Margin="0,0,8,0"
                                     KeyDown="EditorSearch_KeyDown"/>
                            <CheckBox x:Name="MatchCaseCheckBox" Grid.Column="2" Content="区分大小写"
                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="3" Content="查找下一个" Style="{StaticResource SecondaryButton}"
                                    Click="FindNext_Click" Margin="0,0,8,0"/>
                            <Button Grid.Column="4" Content="全部替换" Style="{StaticResource SecondaryButton}"
                                    Click="ReplaceAll_Click" Margin="0,0,8,0"/>
                            <Button Grid.Column="5" Content="A−" Style="{StaticResource SecondaryButton}"
                                    Click="DecreaseFont_Click" Margin="0,0,4,0"/>
                            <Button Grid.Column="6" Content="A+" Style="{StaticResource SecondaryButton}"
                                    Click="IncreaseFont_Click" Margin="0,0,8,0"/>
                            <TextBlock x:Name="EditorMatchText" Grid.Column="7" Style="{StaticResource SmallText}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBox x:Name="TextPreview" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     FontSize="12" Padding="8" Visibility="Collapsed"
                                     TextChanged="TextPreview_TextChanged"/>

                            <TreeView x:Name="JsonPreview" BorderThickness="0" Background="Transparent"
                                      Visibility="Collapsed">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="  "/>
                                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <DataGrid x:Name="DatPreview" IsReadOnly="True" AutoGenerateColumns="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      RowHeight="24"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.IsDeferredScrollingEnabled="True"
                                      Visibility="Collapsed"/>

                            <TextBlock x:Name="PreviewEmpty" Text="选择文件查看预览"
                                       Style="{StaticResource NormalText}"
                                       Foreground="{DynamicResource PlaceholderBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PreviewError" TextWrapping="Wrap" Padding="12"
                                       Style="{StaticResource NormalText}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,4"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪"
                           Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar" Grid.Column="1" Width="140" Height="4"
                             Visibility="Collapsed" HorizontalAlignment="Right" Margin="12,0"/>
                <Button x:Name="CancelButton" Grid.Column="2" Content="取消"
                        Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0"
                        Visibility="Collapsed" Click="CancelButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
