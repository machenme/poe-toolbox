<UserControl x:Class="PoEToolbox.Plugins.DataBrowser.MapNumberSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="地图数字预览" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
            <Border Width="260" Height="260" Background="{DynamicResource SurfaceBrush}"
                    HorizontalAlignment="Center" Padding="0" CornerRadius="4">
                <Grid>
                    <Image x:Name="BackgroundImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="预览数字" Style="{StaticResource SmallText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="PreviewNumberComboBox" Grid.Column="1" Height="32"
                          SelectionChanged="PreviewNumberComboBox_SelectionChanged"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="TargetDescription"
                       Text="调整参数后，地图数字及其低 mip 将统一使用当前设置。"
                       Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="字体" Style="{StaticResource SmallText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="FontFamilyComboBox" Grid.Column="1" Height="32"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="字体大小" Style="{StaticResource SmallText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="8" Maximum="56"
                        Value="40" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="FontSizeSlider_ValueChanged"/>
                <TextBlock x:Name="FontSizeText" Grid.Column="2" Text="40 px"
                           Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="水平偏移" Style="{StaticResource SmallText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="OffsetXSlider" Grid.Column="1" Minimum="-10" Maximum="10"
                        Value="-1" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OffsetSlider_ValueChanged"/>
                <TextBlock x:Name="OffsetXText" Grid.Column="2" Text="-1 px"
                           Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="垂直偏移" Style="{StaticResource SmallText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="OffsetYSlider" Grid.Column="1" Minimum="-10" Maximum="10"
                        Value="3" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OffsetSlider_ValueChanged"/>
                <TextBlock x:Name="OffsetYText" Grid.Column="2" Text="3 px"
                           Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
