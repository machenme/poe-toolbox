<UserControl x:Class="PoEToolbox.Plugins.DataBrowser.MapNumberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="写入设置" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                        <Button x:Name="LoadButton" Content="读取游戏数据" Style="{StaticResource SecondaryButton}"
                                Height="36" IsEnabled="False" Click="LoadButton_Click"/>
                        <Button x:Name="ApplyButton" Content="写入地图标签" Style="{StaticResource PrimaryButton}"
                                Height="48" FontSize="15" IsEnabled="False" Margin="0,8,0,0" Click="ApplyButton_Click"/>
                        <TextBlock Text="写入前会自动保存当前索引快照。"
                                   Style="{StaticResource SmallText}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="420"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="1.2*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="地图标签设置" Style="{StaticResource SectionText}"/>
                        <TextBlock x:Name="PreviewHint" Text="预览与样式调整；写入时才读取客户端数据。"
                                   Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="SettingsPlaceholder" Text="请先在主窗口选择游戏数据"
                                       Style="{StaticResource NormalText}"
                                       Foreground="{DynamicResource PlaceholderBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentControl x:Name="SettingsHost" Margin="0,4"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="输出" Style="{StaticResource SectionText}"/>
                        <TextBlock x:Name="OutputText" Grid.Row="1" Text="等待主窗口选择游戏数据。"
                                   Style="{StaticResource NormalText}"
                                   Foreground="{DynamicResource PlaceholderBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,4" Margin="0,8,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar x:Name="ProgressBar" Width="120" Height="4" Visibility="Collapsed"/>
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                            Height="26" Padding="10,0" Margin="12,0,0,0"
                            Visibility="Collapsed" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
