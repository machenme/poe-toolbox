<Window x:Class="PoEToolbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PoEToolbox.Ui;assembly=PoEToolbox.Ui"
        Title="PoE Toolbox" Height="1000" Width="1560"
        MinHeight="760" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Disclaimer overlay (covers content area only) ═══════════ -->
        <Border x:Name="DisclaimerOverlay" Grid.Row="2"
                Background="{DynamicResource WindowBgBrush}"
                Visibility="Collapsed" Panel.ZIndex="100"/>

        <!-- ═══ Header (56px) ═══════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="LblAppTitle" Style="{StaticResource TitleText}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button x:Name="OpenDataFolderButton" Click="OpenDataFolderButton_Click"
                            Height="30" Padding="12,0" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Cursor="Hand"/>
                    <!-- Language toggle -->
                    <Button x:Name="LangBtn" Click="LangBtn_Click"
                            Width="32" Height="32" FontSize="13"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand" ToolTip="Language" FontWeight="SemiBold"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background"
                                                Value="{DynamicResource ButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="VersionBtn" Click="VersionBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,0" Cursor="Hand" ToolTip="Update">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblVersion"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SmallText}"/>
                            <Border x:Name="UpdateDot"
                                    Width="8" Height="8"
                                    Margin="6,0,0,0"
                                    CornerRadius="4"
                                    Background="{DynamicResource ErrorBrush}"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Game data bar ═══ 独占整行整宽：索引路径近 90 字符，缩在标题栏里必然被切掉 ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameDataPathDisplay" MinHeight="30" IsReadOnly="True"
                         VerticalContentAlignment="Center" TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled" Padding="8,5"
                         Text="未选择游戏数据"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectGameDataButton" Content="选择游戏数据"
                            Height="30" Padding="12,0" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="SelectGameDataButton_Click"/>
                    <Button x:Name="ReleaseGgpkButton" Click="ReleaseGgpkButton_Click"
                            Height="30" Padding="12,0" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Cursor="Hand" ToolTip="释放游戏数据文件占用"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Body ════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左导航：搜索框 + 分组模块项（选中态为左侧指示条，非整块填充） -->
            <Grid Grid.Column="0" Margin="12,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <Grid Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock x:Name="NavSearchIcon" Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="NavSearchBox" Height="30" Padding="28,0,26,0"
                             VerticalContentAlignment="Center"
                             TextChanged="NavSearchBox_TextChanged"
                             ToolTip="搜索模块"/>
                    <Button x:Name="NavSearchClear" Width="22" Height="22"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Content="&#xE711;" FontSize="11"
                            FontFamily="Segoe MDL2 Assets"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            Cursor="Hand" Visibility="Collapsed"
                            Click="NavSearchClear_Click"/>
                </Grid>

                <ListBox x:Name="NavList" Grid.Row="1" SelectionChanged="NavList_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource CaptionText}"
                                               FontWeight="SemiBold"
                                               Margin="12,12,12,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding IconGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSm}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,2"/>
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" CornerRadius="4">
                                            <Grid>
                                                <Border x:Name="bd" Background="Transparent"
                                                        CornerRadius="4" Padding="8,0"/>
                                                <!-- Fluent 选中指示条：左侧 3px 竖条 -->
                                                <Border x:Name="indicator" Width="3"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        CornerRadius="2"/>
                                                <ContentPresenter Margin="8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource CardHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <!-- 底色走品牌金浅底，指示条走品牌金：选中态一眼认出是本工具箱 -->
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource NavSelectionBrush}"/>
                                                <Setter TargetName="indicator" Property="Background"
                                                        Value="{DynamicResource BrandBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                                <!-- Plugin 为 null 的有两种：Dashboard 项要显示，纯分组占位项要收起 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Plugin}" Value="{x:Null}"/>
                                        <Condition Binding="{Binding IsDashboard}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Content area：模块页头（图标+标题+一句作用说明）+ 模块视图。
                 页头由外壳统一托管，不写进各插件视图 XAML：
                 IPlugin 已提供 IconGlyph / Name / Summary，新增插件自动获得页头，
                 且标题走 UILabels 三语，不会在视图里散落硬编码中文。

                 内容整体水平居中并限制最大宽度：窗口拉宽时不至于让一行文字横跨
                 两千像素，左侧导航仍保持左列（Fluent 习惯）。

                 这里刻意不写 Width="100%"：Grid.Width 默认按绝对 Length 解析，
                 "100%" 会抛 FormatException「无法将"100%"字符串转换为 Length」，
                 整个窗口 LoadComponent 失败、启动即崩。居中 + MaxWidth 已经能
                 撑满可用空间并居中，不需要显式宽度。 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid MaxWidth="1180" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:PageHeader x:Name="ModuleHeader" Grid.Row="0"/>
                    <ContentControl x:Name="PluginContent" Grid.Row="1"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══ 页脚：日志抽屉 + 状态行 ═══════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 全局日志抽屉：默认 Visibility=Collapsed，不占高度 -->
                <Border x:Name="GlobalLogPanel" Grid.Row="0"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                        Padding="12,8" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="全局输出日志（全部模块的操作流水，与文件日志同源）"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ClearGlobalLogButton" Content="清空" Click="ClearGlobalLogButton_Click"
                                        Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0"
                                        FontSize="11" VerticalAlignment="Center"/>
                                <Button x:Name="HideGlobalLogButton" Content="收起" Click="HideGlobalLogButton_Click"
                                        Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0"
                                        FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <RichTextBox x:Name="GlobalLogBox" Grid.Row="1" IsReadOnly="True"
                                     Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="8,4"
                                     Height="200"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto">
                            <FlowDocument PagePadding="0">
                                <Paragraph Margin="0"/>
                            </FlowDocument>
                        </RichTextBox>
                    </Grid>
                </Border>

                <!-- 状态行 -->
                <Grid Grid.Row="1" Height="34" Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 整体兜底入口：无论当前在哪个模块，改坏了游戏都能从这里一键彻底还原官方客户端 -->
                        <Button x:Name="RestoreBaselineButton" Click="RestoreBaselineButton_Click"
                                Content="彻底还原游戏客户端"
                                Style="{StaticResource SecondaryButton}"
                                Height="24" Padding="10,0" FontSize="11"
                                Foreground="{DynamicResource ErrorBrush}"
                                Cursor="Hand"
                                ToolTip="整体兜底：把游戏彻底还原成官方原版——整包替换型补丁（如汉化包）覆盖的原生文件按备份清单放回，再用原版索引替换当前索引并删除所有补丁新增的文件（含第三方补丁）。任何模块改坏了游戏都可以用它恢复；日常卸载单个补丁请到「特效补丁」页。"/>
                        <TextBlock x:Name="StatusLabel" Text="Ready"
                                   Style="{StaticResource SmallText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="GlobalLogToggle" Click="GlobalLogToggle_Click"
                            Content="▤ 输出日志"
                            Style="{StaticResource SecondaryButton}"
                            Height="24" Padding="10,0" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="展开/收起全局输出日志（全部模块的操作流水）"/>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="UpdateDialogOverlay" Grid.RowSpan="4"
                Background="{DynamicResource OverlayBrush}"
                Visibility="Collapsed" Panel.ZIndex="200">
            <Border Width="480" MaxHeight="600" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="UpdateDialogTitle"
                               Style="{StaticResource SectionText}"/>
                    <TextBlock x:Name="UpdateDialogVersion" Grid.Row="1"
                               Margin="0,6,0,16"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <ScrollViewer Grid.Row="2" MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="UpdateDialogNotes"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" LineHeight="22"/>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Button x:Name="SkipUpdateButton"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Style="{StaticResource SecondaryButton}"
                                Click="SkipUpdateButton_Click"/>
                        <Button x:Name="OpenReleasesButton"
                                HorizontalAlignment="Right"
                                Padding="12,6"
                                Style="{StaticResource PrimaryButton}"
                                Click="OpenReleasesButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
