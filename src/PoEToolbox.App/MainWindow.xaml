<Window x:Class="PoEToolbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE Toolbox" Height="800" Width="1220"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ═══ Disclaimer overlay (covers content area only) ═══════════ -->
        <Border x:Name="DisclaimerOverlay" Grid.Row="1"
                Background="{DynamicResource WindowBgBrush}"
                Visibility="Collapsed" Panel.ZIndex="100"/>

        <!-- ═══ Header (64px) ═══════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="LblAppTitle" Style="{StaticResource TitleText}"/>
                    <TextBlock x:Name="LblSubtitle" Style="{StaticResource NormalText}" Margin="0,1,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GameDataPathDisplay" Height="32" IsReadOnly="True"
                             VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                             Padding="8,0" TextWrapping="NoWrap"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                             Text="未选择游戏数据"/>
                    <Button Grid.Column="1" x:Name="SelectGameDataButton" Content="选择游戏数据"
                            Height="32" Padding="12,0" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="SelectGameDataButton_Click"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button x:Name="ReleaseGgpkButton" Click="ReleaseGgpkButton_Click"
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Cursor="Hand" ToolTip="释放游戏数据文件占用"/>
                    <Button x:Name="OpenDataFolderButton" Click="OpenDataFolderButton_Click"
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Cursor="Hand"/>
                    <!-- Language toggle -->
                    <Button x:Name="LangBtn" Click="LangBtn_Click"
                            Width="36" Height="36" FontSize="14"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand" ToolTip="Language" FontWeight="SemiBold"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background"
                                                Value="{DynamicResource ButtonBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Theme toggle (hidden for now) -->
                    <Button x:Name="ThemeBtn" Click="ThemeBtn_Click"
                            Width="36" Height="36" FontSize="16"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand" ToolTip="Theme"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE706;"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background"
                                                Value="{DynamicResource ButtonBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="VersionBtn" Click="VersionBtn_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" Margin="10,0,0,0"
                            Cursor="Hand" ToolTip="Update">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblVersion"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SmallText}"/>
                            <Border x:Name="UpdateDot"
                                    Width="8" Height="8"
                                    Margin="6,0,0,0"
                                    CornerRadius="4"
                                    Background="#E53935"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Body ════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav（宽度自适应最长模块名） -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="4">
                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         VerticalAlignment="Top">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionText}"
                                               Margin="8,12,8,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding IconGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent"
                                                CornerRadius="6" Padding="8,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource ButtonBgBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Plugin}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Content area -->
            <ContentControl x:Name="PluginContent" Grid.Column="2"/>
        </Grid>

        <!-- ═══ Global log dock (collapsed by default) ═══════════ -->
        <Border x:Name="GlobalLogPanel" Grid.Row="2" Height="220"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <Grid Margin="12,6,12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="全局输出日志（全部模块的操作流水，与文件日志同源）"
                               Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ClearGlobalLogButton" Content="清空" Click="ClearGlobalLogButton_Click"
                                Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0"
                                FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="HideGlobalLogButton" Content="收起" Click="HideGlobalLogButton_Click"
                                Style="{StaticResource SecondaryButton}" Height="24" Padding="10,0"
                                FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <RichTextBox x:Name="GlobalLogBox" Grid.Row="1" IsReadOnly="True"
                             Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource InputBgBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1" Padding="8,4"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto">
                    <FlowDocument PagePadding="0">
                        <Paragraph Margin="0"/>
                    </FlowDocument>
                </RichTextBox>
            </Grid>
        </Border>

        <!-- ═══ Status Bar (32px) ════════════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 整体兜底入口：无论当前在哪个模块，改坏了游戏都能从这里一键彻底还原官方客户端 -->
                    <Button x:Name="RestoreBaselineButton" Click="RestoreBaselineButton_Click"
                            Content="彻底还原游戏客户端"
                            Style="{StaticResource SecondaryButton}"
                            Height="24" Padding="10,0" FontSize="11"
                            Foreground="{DynamicResource ErrorBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}"
                            Cursor="Hand"
                            ToolTip="整体兜底：把游戏彻底还原成官方原版——整包替换型补丁（如汉化包）覆盖的原生文件按备份清单放回，再用原版索引替换当前索引并删除所有补丁新增的文件（含第三方补丁）。任何模块改坏了游戏都可以用它恢复；日常卸载单个补丁请到「特效补丁」页。"/>
                    <TextBlock x:Name="StatusLabel" Text="Ready"
                               Style="{StaticResource SmallText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="GlobalLogToggle" Click="GlobalLogToggle_Click"
                        Content="▤ 输出日志"
                        Style="{StaticResource SecondaryButton}"
                        Height="24" Padding="10,0" FontSize="11"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="展开/收起全局输出日志（全部模块的操作流水）"/>
            </Grid>
        </Border>

        <Border x:Name="UpdateDialogOverlay" Grid.RowSpan="3"
                Background="#80000000"
                Visibility="Collapsed" Panel.ZIndex="200">
            <Border Width="480" MaxHeight="600" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="UpdateDialogTitle"
                               Style="{StaticResource SectionText}"/>
                    <TextBlock x:Name="UpdateDialogVersion" Grid.Row="1"
                               Margin="0,6,0,16"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <ScrollViewer Grid.Row="2" MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="UpdateDialogNotes"
                                   Style="{StaticResource SmallText}"
                                   TextWrapping="Wrap" LineHeight="22"/>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Button x:Name="SkipUpdateButton"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Style="{StaticResource SecondaryButton}"
                                Click="SkipUpdateButton_Click"/>
                        <Button x:Name="OpenReleasesButton"
                                HorizontalAlignment="Right"
                                Padding="12,6"
                                Style="{StaticResource PrimaryButton}"
                                Click="OpenReleasesButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
