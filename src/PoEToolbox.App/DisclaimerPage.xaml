<UserControl x:Class="PoEToolbox.App.DisclaimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Margin="0,0,0,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="24" Margin="0,0,0,16">
                    <TextBlock x:Name="DisclaimerText" FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="26"/>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="24">
                    <TextBlock x:Name="HowToText" FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="26"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RejectBtn" Style="{StaticResource SecondaryButton}"
                    Width="130" Height="36" Click="Reject_Click" Margin="0,0,12,0"/>
            <Button x:Name="AcceptBtn" Style="{StaticResource PrimaryButton}"
                    Width="200" Height="36" Click="Accept_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
