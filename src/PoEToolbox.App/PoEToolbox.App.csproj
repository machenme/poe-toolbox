<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>PoEToolbox.App</RootNamespace>
    <AssemblyName>PoEToolbox</AssemblyName>
    <Version>0.1.6</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>../../publish/</PublishDir>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoEToolbox.Shared\PoEToolbox.Shared.csproj" />
    <ProjectReference Include="..\PoEToolbox.Plugins.PriceTagger\PoEToolbox.Plugins.PriceTagger.csproj" />
    <ProjectReference Include="..\PoEToolbox.Plugins.DataBrowser\PoEToolbox.Plugins.DataBrowser.csproj" />
    <ProjectReference Include="..\PoEToolbox.Plugins.BagCleaner\PoEToolbox.Plugins.BagCleaner.csproj" />
    <ProjectReference Include="..\PoEToolbox.Plugins.Voyager\PoEToolbox.Plugins.Voyager.csproj" />
    <ProjectReference Include="..\PoEToolbox.Plugins.PoeCnPatch\PoEToolbox.Plugins.PoeCnPatch.csproj" />
    <ProjectReference Include="..\PoEToolbox.Plugins.Poe2Font\PoEToolbox.Plugins.Poe2Font.csproj" />
    <ProjectReference Include="..\PoEToolbox.Plugins.TermTranslator\PoEToolbox.Plugins.TermTranslator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Themes\*.xaml" />
    <EmbeddedResource Include="..\LibDat2\DatDefinitions.json" Link="DatDefinitions.json" />
    <EmbeddedResource Include="../../oo2core.dll" Link="oo2core.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime caches are user data and are not publish inputs. -->
    <Content Remove="work\**" />
    <None Remove="work\**" />
    <EmbeddedResource Remove="work\**" />
  </ItemGroup>

  <Target Name="PostPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)\*.pdb" />
    <Delete Files="$(PublishDir)\*.xml" />
  </Target>

</Project>
