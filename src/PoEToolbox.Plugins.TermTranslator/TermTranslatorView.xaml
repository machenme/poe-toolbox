<UserControl x:Class="PoEToolbox.Plugins.TermTranslator.TermTranslatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="152"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="152"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="源语言" Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SourceLanguageBox" Grid.Column="1" DisplayMemberPath="Name"
                          SelectionChanged="Language_SelectionChanged"/>
                <Button Grid.Column="2" Content="⇄" Style="{StaticResource SecondaryButton}" Width="36" Padding="0"
                        Margin="8,0" ToolTip="交换源语言和目标语言" Click="SwapLanguages_Click"/>
                <ComboBox x:Name="TargetLanguageBox" Grid.Column="3" DisplayMemberPath="Name"
                          SelectionChanged="Language_SelectionChanged"/>
                <TextBlock x:Name="LanguageStatus" Grid.Column="4" Style="{StaticResource SmallText}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button x:Name="CancelButton" Grid.Column="5" Content="取消" Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed" Margin="12,0,0,0" Click="Cancel_Click"/>
                <Button x:Name="TranslateButton" Grid.Column="6" Content="翻译" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="Translate_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="原文" Style="{StaticResource SectionText}" VerticalAlignment="Center"/>
                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource SecondaryButton}"
                                Width="34" Padding="0" HorizontalAlignment="Right" ToolTip="清空原文和译文" Click="Clear_Click"/>
                    </Grid>
                    <TextBox x:Name="SourceTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Top" Padding="10" TextChanged="SourceTextBox_TextChanged"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="译文" Style="{StaticResource SectionText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DecreaseFontSizeButton" Content="A-"
                                    Style="{StaticResource SecondaryButton}" Width="34" Height="28"
                                    Padding="0" ToolTip="缩小译文字号" Click="DecreaseFontSize_Click"/>
                            <TextBlock x:Name="FontSizeText" Style="{StaticResource SmallText}"
                                       Width="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" ToolTip="当前译文字号"/>
                            <Button x:Name="IncreaseFontSizeButton" Content="A+"
                                    Style="{StaticResource SecondaryButton}" Width="34" Height="28"
                                    Padding="0" ToolTip="放大译文字号" Click="IncreaseFontSize_Click"/>
                            <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource SecondaryButton}" Width="34" Height="28"
                                    Padding="0" Margin="8,0,0,0" HorizontalAlignment="Right"
                                    ToolTip="复制译文" Click="Copy_Click"/>
                        </StackPanel>
                    </Grid>
                    <RichTextBox x:Name="TranslationTextBox" Grid.Row="2" IsReadOnly="True" IsDocumentEnabled="False"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <FlowDocument PagePadding="0">
                            <Paragraph Margin="0"/>
                        </FlowDocument>
                    </RichTextBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8,5" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <TextBlock x:Name="StatusText" Text="就绪。原文将发送至 Microsoft Edge 在线翻译服务。"
                       Style="{StaticResource SmallText}"/>
        </Border>
    </Grid>
</UserControl>
