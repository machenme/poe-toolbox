<Window x:Class="PoEToolbox.Plugins.AffixWorkbench.ColorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PoEToolbox.Plugins.AffixWorkbench"
        Title="颜色修改" Width="620" Height="760" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <local:AffixColorBrushConverter x:Key="AffixBrush"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Button Content="新增颜色" Style="{StaticResource SecondaryButton}" Click="Add_Click"
                            ToolTip="新增一个颜色标签，id 可直接改，颜色与透明度用下方滑条调整"/>
                    <Button Content="新增下一级" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Click="AddLevel_Click"
                            ToolTip="以选中颜色为基础生成下一等级：同色系、透明度 −50、id 末尾数字 +1（如 LUK1 → LUK2）"/>
                </StackPanel>
                <TextBlock Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="新颜色会随「应用词缀修改」一起写入游戏，之后所有词缀都能引用；透明度用来区分同一色系的等级深浅（越暗 = 等级越低）。"/>
            </StackPanel>
            <ListBox x:Name="ColorList" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" SelectionChanged="ColorList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="126"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="20" CornerRadius="3"
                                    Background="{Binding Swatch}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    ToolTip="预览：列表与检查器按此 id 显示颜色"/>
                            <TextBox Grid.Column="1" Height="26" Margin="6,0,0,0"
                                     Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="颜色标签 id（字母开头、仅字母数字、≤16 字符）；改名等于换标签，游戏里旧 id 会失效"/>
                            <TextBox Grid.Column="2" Height="26" Tag="{Binding}" TextChanged="Hex_TextChanged"
                                     ToolTip="#RRGGBB / #AARRGGBB / R,G,B / A,R,G,B"/>
                            <Button Grid.Column="3" Content="删除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Delete_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 选中颜色的 RGBA 滑条编辑区 -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                Background="{DynamicResource SurfaceBrush}">
            <StackPanel>
                <TextBlock x:Name="EditingLabel" Text="选中下方颜色后拖动滑条调整（或直接填 #RRGGBB / #AARRGGBB）"
                           Style="{StaticResource SmallText}"/>
                <Grid Margin="0,6,0,0" x:Name="SliderPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="R" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                    <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="8,0"/>
                    <TextBox x:Name="RBox" Grid.Column="2" Height="24" IsReadOnly="True" Text="{Binding Value, ElementName=RSlider, Mode=OneWay}"/>
                    <TextBlock Grid.Row="1" Text="G" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                    <Slider x:Name="GSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="8,0"/>
                    <TextBox x:Name="GBox" Grid.Row="1" Grid.Column="2" Height="24" IsReadOnly="True" Text="{Binding Value, ElementName=GSlider, Mode=OneWay}"/>
                    <TextBlock Grid.Row="2" Text="B" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                    <Slider x:Name="BSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="8,0"/>
                    <TextBox x:Name="BBox" Grid.Row="2" Grid.Column="2" Height="24" IsReadOnly="True" Text="{Binding Value, ElementName=BSlider, Mode=OneWay}"/>
                    <TextBlock Grid.Row="3" Text="A" Style="{StaticResource SmallText}" VerticalAlignment="Center"
                               ToolTip="透明度：255 = 完全不透明，越小越暗（用来表达等级高低）"/>
                    <Slider x:Name="ASlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="8,0"/>
                    <TextBox x:Name="ABox" Grid.Row="3" Grid.Column="2" Height="24" IsReadOnly="True" Text="{Binding Value, ElementName=ASlider, Mode=OneWay}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 游戏里已经在用的颜色（第三方补丁 / 游戏自带）：只读，可拿来当自己做色的起点 -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="4" x:Name="ExternalPanel"
                Background="{DynamicResource SurfaceBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource SmallText}" TextWrapping="Wrap"
                               Text="游戏里已经在用的颜色：第三方补丁或游戏自带的配色。游戏自带的定义有 300 多个，下面只列出被当前词缀真的引用到的这些。"/>
                    <TextBlock Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="点右侧按钮可以照抄它的颜色，做成你自己的一个新颜色——之后把这个颜色指派给某条词缀，那一条就会换成你的颜色，同一款补丁上的其他词缀不受影响。"/>
                </StackPanel>
                <TextBlock x:Name="ExternalEmpty" DockPanel.Dock="Top" Margin="0,8,0,0"
                           Style="{StaticResource SmallText}" TextWrapping="Wrap"
                           Text="没有读到游戏里已存在的颜色——客户端当前没有装词缀配色补丁。" Visibility="Collapsed"/>
                <ListBox x:Name="ExternalList" Margin="0,8,0,0" MaxHeight="168" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Height="20" CornerRadius="3"
                                        Background="{Binding Id, Converter={StaticResource AffixBrush}}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        ToolTip="游戏里这个颜色的实际样子"/>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Id}" ToolTip="{Binding Id}"/>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SmallText}" Text="{Binding Hex}"/>
                                <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SmallText}" Text="{Binding Note}"
                                           ToolTip="游戏文件里的原始写法（不带 #：R,G,B 或 A,R,G,B）"/>
                                <Button Grid.Column="4" Content="照抄这个颜色" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="Take_Click"
                                        ToolTip="用它当前的颜色新建一个属于你的颜色（id 会自动避开同名），之后就能指派给词缀"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="80" Click="Cancel_Click"/>
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Width="80" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
