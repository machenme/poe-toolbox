<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      ═══ 设计令牌（PoE 金色主调 + Fluent 交互规范）═════════════════════
      配色分工：
        · 金色 #C89B3C —— 品牌色。用在图标底板、强调标识、选中指示条这类「点缀」处，
          让界面一眼认出是 PoE Toolbox，而不是任何一个 Fluent 应用。
        · 蓝色 #0F6CBD —— 交互色。用在需要「可点/ 选中 / 聚焦」的控件状态上。
          这类状态借用 Fluent 蓝是因为它经过对比度验证，深浅背景下都读得清；
          若改金色，#C89B3C 在白底上对比度不足（≈2.4:1），会变成看不清的选中态。
      界面结构（间距、圆角、字号、两级信息层次）仍然是 PowerToys 那一套，
      只换配色不改骨架。

      改配色只改这里。控件与视图一律引用语义 key，不得出现字面色值
      （tests/PoEToolbox.Tests/XamlTokenGuardTests.cs 守着这条）。
    -->

    <!-- ═══ Surfaces ═════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EEEEEE"/>

    <!-- ═══ Text ═════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9E9E9E"/>

    <!-- ═══ Brand（PoE 金）：图标底板、选中指示条、品牌标识 ═════ -->
    <SolidColorBrush x:Key="BrandBrush" Color="#C89B3C"/>
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#D8AC52"/>
    <SolidColorBrush x:Key="BrandPressedBrush" Color="#A9822F"/>
    <!-- 品牌色的浅底：图标底板 / 选中行底色用这个，金色本身当背景会太亮 -->
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="#FBF5E9"/>
    <SolidColorBrush x:Key="BrandBorderBrush" Color="#E3CE9A"/>
    <!-- 金色上的文字：必须用深色才读得清 -->
    <SolidColorBrush x:Key="BrandForegroundBrush" Color="#FFFFFF"/>

    <!-- ═══ Interactive（Fluent 蓝）：可点 / 聚焦 / 选中态 ═════ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1B84E0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0C5AAC"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EFF6FC"/>

    <!-- ═══ Semantics ════════════════════════════════════ -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B75E00"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>

    <!-- ═══ Interactive states ═══════════════════════════ -->
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <!-- 选中/悬停底色走品牌金浅底，一眼可辨是本工具箱 -->
    <SolidColorBrush x:Key="TagSelectedBgBrush" Color="#FBF5E9"/>
    <SolidColorBrush x:Key="RowHoverBgBrush" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="RowSelectedBgBrush" Color="#FBF5E9"/>
    <SolidColorBrush x:Key="NavSelectionBrush" Color="#FBF5E9"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>

    <!-- ═══ Radii / spacing / sizes / motion ═════════════ -->
    <CornerRadius x:Key="CornerXs">2</CornerRadius>
    <CornerRadius x:Key="CornerSm">4</CornerRadius>
    <CornerRadius x:Key="CornerMd">4</CornerRadius>
    <CornerRadius x:Key="CornerLg">8</CornerRadius>
    <CornerRadius x:Key="CornerXl">12</CornerRadius>
    <CornerRadius x:Key="CornerPill">16</CornerRadius>

    <sys:Double x:Key="ControlHSm">28</sys:Double>
    <sys:Double x:Key="ControlHMd">32</sys:Double>
    <sys:Double x:Key="ControlHLg">36</sys:Double>

    <Thickness x:Key="PagePadding">20,16,20,8</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <sys:Double x:Key="FontXs">12</sys:Double>
    <sys:Double x:Key="FontSm">13</sys:Double>
    <sys:Double x:Key="FontMd">14</sys:Double>
    <sys:Double x:Key="FontLg">20</sys:Double>
    <sys:Double x:Key="FontXl">28</sys:Double>

    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionNormal">0:0:0.16</Duration>
    <KeySpline x:Key="EaseStandard">0.33,0,0.67,1</KeySpline>

</ResourceDictionary>
