<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Palette (semantic) ═══════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EAEAED"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202124"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#F9F9FB"/>
    <SolidColorBrush x:Key="TagSelectedBgBrush" Color="#FFF8E1"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#AAAAAA"/>

    <!-- Accent (PoE Gold) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#B8860B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D4A420"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#8B6508"/>

    <!-- Semantics -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E65100"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>

    <!-- ═══ Legacy aliases (BagCleaner) ══════════════════════ -->
    <!-- TODO(ui-rebuild commit 2): delete this block after BagCleanerView migrates to the keys above. -->
    <SolidColorBrush x:Key="BgBase" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgHover" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BgPressed" Color="#EAEAED"/>
    <SolidColorBrush x:Key="Border" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#202124"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
    <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0063B2"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#00457C"/>
    <SolidColorBrush x:Key="Warn" Color="#E65100"/>
    <SolidColorBrush x:Key="Ok" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Err" Color="#C62828"/>

</ResourceDictionary>
