<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 字号一律取令牌（FontXs~FontXl），字面量只允许出现在 Tokens.xaml。
         字族统一 YaHei UI（Vista 起的新排版引擎，小字更清楚），回退 YaHei 兜底旧系统。 -->

    <!-- ═══ Type scale ═══════════════════════════════════ -->
    <!-- Display：Dashboard 页面主标题 -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontXl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontLg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontMd}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
    </Style>
    <Style x:Key="NormalText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontXs}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
    </Style>

    <!-- 页头/卡片下的一句说明：比 SmallText 更弱的 tertiary 色 -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontXs}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══ Section / field labels ═══════════════════════════ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontMd}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontXs}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

</ResourceDictionary>
