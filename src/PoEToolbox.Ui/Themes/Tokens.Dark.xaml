<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      ═══ 深色令牌 ══════════════════════════════════════════════════
      与 Tokens.xaml 的 key 集合必须逐字一致。少一个 key，深色下就会回落到
      硬编码默认色（黑底黑字这类问题只在切主题时才暴露，靠肉眼发现太晚）。
      tests/PoEToolbox.Tests/ThemeTokenParityTests.cs 会静态比对本文件与浅色版的 key 集合。

      切换方式：ThemeService 整体替换 App.xaml 的 MergedDictionaries[0]，样式字典不动。
    -->

    <!-- ═══ Surfaces ═════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#272727"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#383838"/>

    <!-- ═══ Text ═════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#8A8A8A"/>

    <!-- ═══ Accent（深色下压暗一档，避免大面积刺眼）═════════════ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CA6E8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#67B4EC"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A8AD0"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#101010"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3A52"/>

    <!-- ═══ Semantics ════════════════════════════════════ -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4"/>

    <!-- ═══ Interactive states ═══════════════════════════ -->
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#272727"/>
    <SolidColorBrush x:Key="TagSelectedBgBrush" Color="#1E3A52"/>
    <SolidColorBrush x:Key="RowHoverBgBrush" Color="#333333"/>
    <SolidColorBrush x:Key="RowSelectedBgBrush" Color="#1E3A52"/>
    <SolidColorBrush x:Key="NavSelectionBrush" Color="#1E3A52"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#4CA6E8"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>

</ResourceDictionary>
