<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design system entry point. Merged by App.xaml.
         Order matters: tokens first, then components that consume them.

         单一浅色主题，不再有运行时切主题，所以颜色令牌直接并回本字典：
         Tokens.xaml 给 PoE 金 + Fluent 蓝的配色与全部尺寸令牌，
         后面几个字典是排版与控件样式，消费上面的令牌。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PoEToolbox.Ui;component/Themes/Tokens.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PoEToolbox.Ui;component/Themes/Typography.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PoEToolbox.Ui;component/Themes/Controls.Button.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PoEToolbox.Ui;component/Themes/Controls.Input.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PoEToolbox.Ui;component/Themes/Controls.Layout.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PoEToolbox.Ui;component/Themes/Controls.Data.xaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
