<UserControl x:Class="PoEToolbox.Plugins.Poe2Font.Poe2FontView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="字体设置" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                        <TextBlock Text="字体类型" Style="{StaticResource SmallText}"/>
                        <ComboBox x:Name="TypefaceBox" IsEditable="True" Height="32" Margin="0,5,0,10"
                                  DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName"
                                  SelectionChanged="FontSettingChanged" LostFocus="FontSettingChanged"/>
                        <TextBlock Text="写入全部 &lt;Font&gt; 的 typeface，并把该字体置顶为 CJK/Any 回退。"
                                   Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="字号调整" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                        <TextBlock Text="整体偏移（个字号）" Style="{StaticResource SmallText}"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OffsetBox" Height="30" Text="2" HorizontalContentAlignment="Right"
                                     Padding="6,0" TextChanged="OffsetBox_TextChanged"/>
                            <Button Grid.Column="1" Content="变 小" Style="{StaticResource SecondaryButton}"
                                    Height="30" Margin="6,0,0,0" Click="DecreaseOffset_Click"/>
                            <Button Grid.Column="2" Content="变 大" Style="{StaticResource PrimaryButton}"
                                    Height="30" Margin="6,0,0,0" Click="IncreaseOffset_Click"/>
                        </Grid>
                        <TextBlock x:Name="OffsetHint" Text="按官方值整体加减若干个字号，可重复点击累加。"
                                   Style="{StaticResource SmallText}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

                        <TextBlock Text="等比缩放（相对官方值）" Style="{StaticResource SmallText}" Margin="0,12,0,0"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PercentBox" Height="30" Text="120" HorizontalContentAlignment="Right"
                                     Padding="6,0"/>
                            <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="6,0"
                                       Style="{StaticResource SmallText}"/>
                            <Button Grid.Column="2" Content="应 用" Style="{StaticResource SecondaryButton}"
                                    Height="30" Click="ApplyPercent_Click"/>
                        </Grid>
                        <TextBlock Text="一次性把每条官方字号按比例折算成绝对字号，重复点同一倍率结果不变。"
                                   Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock Text="单条微调" Style="{StaticResource SmallText}" Margin="0,12,0,0"/>
                        <Button x:Name="ResetButton" Content="全部还原为官方字号" Style="{StaticResource SecondaryButton}"
                                Height="32" Margin="0,5,0,0" Click="ResetSizes_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="执行" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                        <Button x:Name="ApplyButton" Content="应用字体配置"
                                Style="{StaticResource PrimaryButton}" Height="44" Click="Apply_Click"/>
                        <Button x:Name="RestoreButton" Content="恢复首次备份的原始字体"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,8,0,0"
                                IsEnabled="False" Click="Restore_Click"/>
                        <TextBlock Text="应用前会保存两个目标文件的首次原始内容；字号一律按内置官方模板换算成绝对值，重复应用结果一致。"
                                   Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PathStatus" Style="{StaticResource SmallText}"
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="自定义字体配置器" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="下表是游戏客户端里的全部字体条目：作用域对应界面分区，示例文字按调整后的字号渲染。"
                               Style="{StaticResource NormalText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前配置" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PreviewText" Grid.Column="1" Style="{StaticResource TitleText}"
                               Margin="18,0,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="按游戏窗口宽度折算：" Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox x:Name="ResolutionBox" Grid.Column="2" Width="130" Height="30"
                                  SelectionChanged="ResolutionBox_SelectionChanged"/>
                        <CheckBox x:Name="ChangedOnlyBox" Grid.Column="3" Content="只看已改"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  Checked="ChangedOnly_Changed" Unchecked="ChangedOnly_Changed"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="条目" Style="{StaticResource SmallText}"/>
                        <TextBlock Grid.Column="1" Text="官方 → 写入" Style="{StaticResource SmallText}"/>
                        <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource SmallText}"/>
                        <TextBlock Grid.Column="3" x:Name="PreviewStatus" Style="{StaticResource SmallText}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ListView Grid.Row="2" x:Name="EntryList" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Id}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OfficialSize}" FontSize="12" VerticalAlignment="Center"
                                                   TextAlignment="Right" Width="28"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="→" FontSize="12" Margin="6,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Width="46" Height="26" FontSize="12" Padding="4,0"
                                                 HorizontalContentAlignment="Right" Text="{Binding Edit, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StatusText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SampleText}" Margin="8,0,0,0"
                                               FontSize="{Binding PreviewSize}" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12">
                <TextBlock x:Name="ResultText" Text="请先在主窗口选择游戏数据。" Style="{StaticResource SmallText}"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                Padding="8,5" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource SmallText}"/>
        </Border>
    </Grid>
</UserControl>
