<UserControl x:Class="PoEToolbox.Plugins.Poe2Font.Poe2FontView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="POE2 游戏数据" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GameDataPathBox" Height="32"
                                 ToolTip="选择 Content.ggpk、_.index.bin 或包含它们的游戏目录"
                                 TextChanged="GameDataPathBox_TextChanged"/>
                        <Button Grid.Column="2" Content="选择..." Style="{StaticResource SecondaryButton}"
                                Width="88" Click="Browse_Click"/>
                    </Grid>
                    <TextBlock x:Name="PathStatus" Style="{StaticResource SmallText}"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="字体设置" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <TextBlock Text="字体类型" Style="{StaticResource SmallText}"/>
                    <ComboBox x:Name="TypefaceBox" IsEditable="True" Height="32" Margin="0,5,0,10"
                              DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName"
                              SelectionChanged="FontSettingChanged" LostFocus="FontSettingChanged"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字号倍率" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SizeScaleBox" Grid.Column="1" Height="30" Text="100"
                                 HorizontalContentAlignment="Right" Padding="6,0"
                                 TextChanged="FontSettingChanged"/>
                    </Grid>
                    <Slider x:Name="SizeScaleSlider" Minimum="50" Maximum="200" Value="100"
                            TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                            ValueChanged="SizeScaleSlider_ValueChanged"/>
                    <TextBlock Text="以原始 XML 字号为基准，统一缩放 50% 到 200%。"
                               Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="执行" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <Button x:Name="ApplyButton" Content="应用字体配置"
                            Style="{StaticResource PrimaryButton}" Height="44" Click="Apply_Click"/>
                    <Button x:Name="RestoreButton" Content="恢复首次备份的原始字体"
                            Style="{StaticResource SecondaryButton}" Height="36" Margin="0,8,0,0"
                            IsEnabled="False" Click="Restore_Click"/>
                    <TextBlock Text="应用前会保存两个目标文件的首次原始内容；后续调整会基于该备份重新生成。"
                               Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="POE2 字体配置器" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="为繁体中文界面设置字体类型和统一字号倍率。生成文件保留原始 XML 结构，并附带中文配置说明。"
                               Style="{StaticResource NormalText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前配置" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PreviewText" Grid.Column="1" Style="{StaticResource TitleText}"
                               Margin="18,0,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字体实时预览" Style="{StaticResource SectionText}"/>
                        <TextBlock x:Name="PreviewStatus" Grid.Column="1" Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Border Padding="14" Background="{DynamicResource SurfaceBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="PreviewLarge" Text="流放者 Exile 0123456789"
                                           FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PreviewNormal" Text="装备属性 · Item Properties · 伤害 Damage"
                                           FontSize="28" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PreviewSmall" Text="地图等级 16　生命 100%　抗性 +75%　Chaos Resistance"
                                           FontSize="22" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PreviewTiny" Text="提示：这是游戏内常见的中文、English、数字和符号混合内容。"
                                           FontSize="17" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Margin="0,18,0,0" Padding="10" Background="{DynamicResource SurfaceBrush}">
                        <TextBlock Text="预览使用当前字体和字号倍率显示示例内容；应用时会更新 Font 的 typeface、size 和 CJK/Any fallback。"
                                   Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12">
                <TextBlock x:Name="ResultText" Text="请选择 POE2 游戏数据。" Style="{StaticResource SmallText}"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                Padding="8,5" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
            <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource SmallText}"/>
        </Border>
    </Grid>
</UserControl>
