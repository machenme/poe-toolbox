<UserControl x:Class="PoEToolbox.Plugins.BagCleaner.BagCleanerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PoEToolbox.Plugins.BagCleaner.ViewModels"
        Background="{DynamicResource BgBase}"
        FontFamily="Segoe UI, Microsoft YaHei"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnWindowKeyDown">
    <UserControl.Resources>
        <!-- 导航项样式 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6F0FE"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 仓库筛选格子样式 (ToggleButton) -->
        <Style x:Key="SkipCellButton" TargetType="ToggleButton">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#605E5C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#FAFAFA"
                                BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#107C10"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B5A0B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 左侧导航 (跨所有行) ===== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="清包助手"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="16,20,16,16"/>
                <ListBox SelectedIndex="{Binding CurrentNavIndex}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{DynamicResource NavItem}">
                    <ListBox.Items>
                        <ListBoxItem Content="按键设置"/>
                        <ListBoxItem Content="仓库筛选"/>
                        <ListBoxItem Content="校准坐标"/>
                        <ListBoxItem Content="延迟设置"/>
                        <ListBoxItem Content="进程名称"/>
                    </ListBox.Items>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 顶部标题 ===== -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgBase}" Padding="28,20,28,8">
            <StackPanel>
                <TextBlock Text="POE 清包助手" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="设置热键、仓库筛选、网格坐标和反检测参数" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== 内容区域 (5 个面板叠加, 通过 DataTrigger 控制可见性) ===== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" Padding="28,4,28,12">
            <Grid>
                <!-- ===== 面板 0: 按键设置 ===== -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentNavIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="热键" Style="{DynamicResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 触发清包 -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="触发清包 (F2)" Style="{DynamicResource FieldLabel}"/>
                                <Button x:Name="BtnTriggerKey" Grid.Column="0"
                                        Content="{Binding TriggerKeyDisplay}"
                                        Height="36" MinWidth="100"
                                        HorizontalContentAlignment="Center"
                                        Background="White"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontSize="14" FontWeight="SemiBold"
                                        Margin="0,4,0,0"
                                        Cursor="Hand"
                                        Click="OnTriggerKeyClick"/>
                                <TextBlock Text="POE 仓库打开后按 F2 开始"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- 校准标记 -->
                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <TextBlock Text="校准标记 (F3)" Style="{DynamicResource FieldLabel}"/>
                                <Button x:Name="BtnCalibrateKey"
                                        Content="{Binding CalibrateKeyDisplay}"
                                        Height="36" MinWidth="100"
                                        HorizontalContentAlignment="Center"
                                        Background="White"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontSize="14" FontWeight="SemiBold"
                                        Margin="0,4,0,0"
                                        Cursor="Hand"
                                        Click="OnCalibrateKeyClick"/>
                                <TextBlock Text="校准时标记第 1/2 格用"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- 停止 (hidden, pending development) -->
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="紧急停止 (Esc)" Style="{DynamicResource FieldLabel}"/>
                                <Button x:Name="BtnStopKey"
                                        Content="{Binding StopKeyDisplay}"
                                        Height="36" MinWidth="100"
                                        HorizontalContentAlignment="Center"
                                        Background="White"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontSize="14" FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Margin="0,4,0,0"
                                        Click="OnStopKeyClick"/>
                                <TextBlock Text="任何时候按 Esc 中止"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="互相独立，不能重复。校准标记键仅在'校准坐标'流程中生效。"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,0"/>

                        <TextBlock Text="修饰键 (仅作用于触发键)"
                                   Style="{DynamicResource FieldLabel}" Margin="0,20,0,4"/>
                        <TextBlock Text="例如勾选 Ctrl 后，需按 Ctrl+F2 才能触发清包。如果不需要加修饰键，全部不勾即可。"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Ctrl" IsChecked="{Binding UseCtrl}" Margin="0,0,24,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="Alt"  IsChecked="{Binding UseAlt}"  Margin="0,0,24,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="Shift" IsChecked="{Binding UseShift}" Margin="0,0,24,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="Win"  IsChecked="{Binding UseWin}"  VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 使用说明 -->
                        <Border Background="{DynamicResource BgHover}" CornerRadius="6" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 使用说明" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" LineHeight="22"
                                           Text="1. 首次使用请先切换到「校准坐标」完成背包坐标校准。"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" LineHeight="22"
                                           Text="2. 热键可自定义设置，推荐保持默认 F2/F3/Esc。"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" LineHeight="22"
                                           Text="3. 仓库筛选用于标记不想清理的格子，勾选=跳过该格。"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" LineHeight="22"
                                           Text="4. 仅在城内打开仓库后使用。按停止键可随时中断。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 面板 1: 仓库筛选 ===== -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentNavIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="仓库筛选" Style="{DynamicResource SectionTitle}"/>
                        <TextBlock Text="勾选的格子将在清包时跳过 (绿色 = 跳过)。不勾选 = 正常清理。"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="全选跳过" Style="{DynamicResource SecondaryButton}"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Command="{Binding SelectAllSkipCommand}"/>
                            <Button Content="全部清除" Style="{DynamicResource SecondaryButton}"
                                    Padding="14,6"
                                    Command="{Binding ClearAllSkipCommand}"/>
                        </StackPanel>

                        <!-- 5行 x 12列 = 60 格矩阵 -->
                        <ItemsControl ItemsSource="{Binding SkipCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="5" Columns="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SkipCell}">
                                    <ToggleButton Style="{DynamicResource SkipCellButton}"
                                                  IsChecked="{Binding IsSkipped}"
                                                  Content="{Binding Label}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="提示：第 1 格 = 背包左上角，最后一格 = 右下角。序号按行优先排列。"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===== 面板 2: 校准坐标 ===== -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentNavIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="网格坐标" Style="{DynamicResource SectionTitle}"/>
                            <Button Grid.Column="1" Content="校准坐标..."
                                    Style="{DynamicResource SecondaryButton}" Padding="14,6"
                                    Command="{Binding StartCalibrationCommand}"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,8">
                                <TextBlock Text="起点 X" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding StartX, Mode=OneWay}" IsReadOnly="True" Background="#F8F8F8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0,8,8">
                                <TextBlock Text="起点 Y" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding StartY, Mode=OneWay}" IsReadOnly="True" Background="#F8F8F8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="8,0,8,8">
                                <TextBlock Text="步长 X" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding StepX, Mode=OneWay}" IsReadOnly="True" Background="#F8F8F8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Grid.Row="0" Margin="8,0,0,8">
                                <TextBlock Text="步长 Y" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding StepY, Mode=OneWay}" IsReadOnly="True" Background="#F8F8F8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,0">
                                <TextBlock Text="列数" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,8,0">
                                <TextBlock Text="行数" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding Rows, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="起点/步长为相对比例 (0~100%)，由「校准坐标」自动写入，列数/行数可手动调整"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,0"/>

                        <TextBlock Text="校准完成后坐标会自动保存，无需手动点击保存。"
                                   FontSize="11" Foreground="{DynamicResource Ok}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===== 面板 3: 延迟设置 ===== -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentNavIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="反检测参数" Style="{DynamicResource SectionTitle}"/>
                        <TextBlock Text="调整有封号风险，建议保持默认 40-60ms / ±5px"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,-8,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="点击间隔最小 (ms)" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding IntervalMin, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="点击间隔最大 (ms)" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding IntervalMax, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="像素偏移最小 (px)" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding OffsetMin, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="像素偏移最大 (px)" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="{Binding OffsetMax, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 面板 4: 进程名称 ===== -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentNavIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="POE 进程名" Style="{DynamicResource SectionTitle}"/>
                        <TextBlock Text="多个用英文逗号分隔。默认覆盖 Steam / EGL / 官方客户端"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,-8,0,8"/>
                        <TextBox Text="{Binding PoeProcesses, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="60" AcceptsReturn="False"/>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ===== 底部 Footer (共享) ===== -->
        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource BgBase}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="28,12,28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 状态灯 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding StatusColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                </StackPanel>

                <!-- 按钮组 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="恢复默认" Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,8,0" Padding="14,8"
                            Command="{Binding ResetCommand}"/>
                    <Button Content="取消" Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,8,0" Padding="18,8"
                            Click="OnCancelClick"/>
                    <Button Content="保存" Style="{DynamicResource PrimaryButton}"
                            Padding="22,8"
                            Command="{Binding SaveCommand}"
                            CommandParameter="{x:Null}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
