<UserControl x:Class="PoEToolbox.Plugins.Voyager.VoyagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}"
             PreviewKeyDown="OnWindowKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="航海助手" Style="{StaticResource TitleText}"
                   FontSize="22" Margin="0,0,0,16"/>

        <!-- ═══ Legacy 6×10 copy mode: temporarily hidden ═══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Ctrl+C 复制" Style="{StaticResource SectionTitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="触发复制" Style="{StaticResource FieldLabel}"/>
                        <Button x:Name="BtnTriggerKey"
                                Height="36" MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Background="White"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TextPrimary}"
                                FontSize="14" FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OnTriggerKeyClick"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="校准标记" Style="{StaticResource FieldLabel}"/>
                        <Button x:Name="BtnCalibrateKey"
                                Height="36" MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Background="White"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TextPrimary}"
                                FontSize="14" FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OnCalibrateKeyClick"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="ChkCtrl"  Content="Ctrl"  Margin="0,0,16,0"
                              VerticalAlignment="Center" Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
                    <CheckBox x:Name="ChkAlt"   Content="Alt"   Margin="0,0,16,0"
                              VerticalAlignment="Center" Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
                    <CheckBox x:Name="ChkShift" Content="Shift" Margin="0,0,16,0"
                              VerticalAlignment="Center" Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
                    <CheckBox x:Name="ChkWin"   Content="Win"   VerticalAlignment="Center"
                              Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
                    <Button Content="校准坐标" Style="{StaticResource SecondaryButton}"
                            Padding="14,4" Margin="20,0,0,0" Click="OnCopyCalibrateClick"/>
                    <TextBlock x:Name="CopyCalStatus" Text="未校准"
                               Style="{StaticResource SmallText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Text="6列×10行。Ctrl+C 复制每格内容到文件。"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ Voyage stash cleanup ═══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="海图仓库清理" Style="{StaticResource SectionTitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="触发点击" Style="{StaticResource FieldLabel}"/>
                        <Button x:Name="BtnSmartTriggerKey"
                                Height="36" MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Background="White"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TextPrimary}"
                                FontSize="14" FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OnSmartTriggerKeyClick"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="坐标模式" Style="{StaticResource FieldLabel}"/>
                        <Border Height="36" MinWidth="100" Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                Padding="10,0">
                            <TextBlock Text="固定 2K" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="ChkSmartCtrl"  Content="Ctrl"  Margin="0,0,16,0"
                              VerticalAlignment="Center" Checked="OnSmartModifierChanged" Unchecked="OnSmartModifierChanged"/>
                    <CheckBox x:Name="ChkSmartAlt"   Content="Alt"   Margin="0,0,16,0"
                              VerticalAlignment="Center" Checked="OnSmartModifierChanged" Unchecked="OnSmartModifierChanged"/>
                    <CheckBox x:Name="ChkSmartShift" Content="Shift" Margin="0,0,16,0"
                              VerticalAlignment="Center" Checked="OnSmartModifierChanged" Unchecked="OnSmartModifierChanged"/>
                    <CheckBox x:Name="ChkSmartWin"   Content="Win"   VerticalAlignment="Center"
                              Checked="OnSmartModifierChanged" Unchecked="OnSmartModifierChanged"/>
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="列数" VerticalAlignment="Center"
                               Style="{StaticResource SmallText}" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSmartColumns" Grid.Column="1" Width="60"
                             Text="12" VerticalContentAlignment="Center" IsReadOnly="True"/>
                    <TextBlock Text="行数" Grid.Column="2" VerticalAlignment="Center"
                               Style="{StaticResource SmallText}" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSmartRows" Grid.Column="3" Width="60"
                             Text="20" VerticalContentAlignment="Center" IsReadOnly="True"/>
                    <TextBlock Grid.Column="4" Text="固定 2K (2560×1440)" VerticalAlignment="Center"
                               Style="{StaticResource SmallText}" Margin="12,0,0,0"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="偏移 X" VerticalAlignment="Center"
                               Style="{StaticResource SmallText}" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSmartOffsetX" Grid.Column="1" Width="50"
                             Text="0" VerticalContentAlignment="Center" LostFocus="OnSmartOffsetChanged"/>
                    <TextBlock Text="px" Grid.Column="2" VerticalAlignment="Center"
                               Style="{StaticResource SmallText}" Margin="4,0,12,0"/>
                    <TextBlock Text="偏移 Y" Grid.Column="3" VerticalAlignment="Center"
                               Style="{StaticResource SmallText}" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSmartOffsetY" Grid.Column="4" Width="50"
                             Text="0" VerticalContentAlignment="Center" LostFocus="OnSmartOffsetChanged"/>
                    <TextBlock Text="px" Grid.Column="5" VerticalAlignment="Center"
                               Style="{StaticResource SmallText}" Margin="4,0,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="SmartCalStatus" Text="未校准"
                               Style="{StaticResource SmallText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>

                <TextBlock Text="固定 2K (2560×1440) 屏幕外框 (567,212)–(1110,1110)，截屏识别占用格后只点击有物品的格子。"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ Log ═══ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontSize="12" FontFamily="Consolas"
                           Foreground="{DynamicResource TextSecondary}" Margin="0"
                           TextWrapping="Wrap" Text="就绪\n"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
