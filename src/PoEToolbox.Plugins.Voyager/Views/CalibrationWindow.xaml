<Window x:Class="PoEToolbox.Plugins.Voyager.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="地图仓校准"
        Width="400" Height="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BgBase}"
        FontFamily="Segoe UI, Microsoft YaHei"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}">
    <Border Background="{DynamicResource BgCard}" CornerRadius="8"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="12">
        <StackPanel VerticalAlignment="Center" Margin="20">
            <TextBlock x:Name="TitleText" Text="地图仓校准" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
            <Border Background="{DynamicResource Accent}" CornerRadius="20"
                    Padding="14,4" HorizontalAlignment="Center" Margin="0,10,0,16">
                <TextBlock x:Name="StepText" Text="步骤 1/2"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>
            <TextBlock x:Name="InstructionText"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       TextAlignment="Center"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       Text="将鼠标移到第一张地图中心，按 F6"/>
        </StackPanel>
    </Border>
</Window>
